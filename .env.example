# Copy this file to .env and edit values for your machine.
POWERPULSE_DATASET_PATH=data/raw/LD2011_2014.txt
POWERPULSE_PROCESSED_DATA_PATH=data/processed/readings
POWERPULSE_OUTPUTS_PATH=outputs
POWERPULSE_MODELS_PATH=models
POWERPULSE_LOGS_PATH=logs

POWERPULSE_SPARK_MASTER=local[*]
POWERPULSE_SPARK_APP_NAME=PowerPulse
POWERPULSE_SPARK_TIMEZONE=UTC

POWERPULSE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
POWERPULSE_KAFKA_TOPIC=powerpulse-readings
